# Neon Postgres Database (required, server-side only)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require"

# Gemini AI API Key (required, server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Single-user Workspace Authentication (required on Vercel; also signs session cookies)
APP_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Zoho Mail API - India Data Center (.in)
ZOHO_CLIENT_ID="MY_ZOHO_CLIENT_ID"
ZOHO_CLIENT_SECRET="MY_ZOHO_CLIENT_SECRET"
ZOHO_REFRESH_TOKEN="MY_ZOHO_REFRESH_TOKEN"
ZOHO_ACCOUNT_ID="MY_ZOHO_ACCOUNT_ID"
ZOHO_FROM_ADDRESS="outreach@yourdomain.in"

# Optional Daily Email Sending Hard Cap (defaults to 30)
DAILY_SEND_CAP="30"
